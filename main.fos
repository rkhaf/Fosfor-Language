fungsi main isinya
    bikin variabel namanya total tipenya integer nilainya 0;
    bikin variabel namanya i tipenya integer nilainya 1;

    tampilin("mulai perulangan...");

    mulaiTimer();

    ngulangin selama (i <= 20000000) isinya
        total++;
        
        // Cek kalau i kelipatan 5.000.000, print progress-nya!
        kalau (i % 5000000 == 0) isinya
            tampilin("iterasi ke:");
            tampilin(i);
        akhir

        i++;
    akhir

    tampilin("dh selesai bg");
akhir;