fungsi main isinya
    bikin variabel namanya total tipenya integer nilainya 0;
    bikin variabel namanya i tipenya integer nilainya 0;
    bikin variabel namanya j tipenya integer nilainya 0;

    ngulangin selama (i < 10) isinya
        j = 0;
        
        ngulangin selama (j < 10) isinya
            total++;
            j++;
        akhir
        
        i++;
    akhir

    // Print sekali aja di luar loop biar gak ke-choke I/O
    tampilin(total);
akhir;